  "info": {
    "description": "Headless catalog imagery pipeline. Submit up to four camera angles per jewelry piece; poll for per-angle status. See docs/api-routes.md.",
    "title": "Jewelry Generation API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/config": {
      "get": {
        "operationId": "get_config_api_v2_config_get",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid API key"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Config unavailable"
          }
        },
        "summary": "Get Config",
        "tags": [
          "config"
        ]
      }
    },
    "/api/v2/generate": {
      "post": {
        "operationId": "create_job_api_v2_generate_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Idempotency-Key missing"
          },
          "401": {
            "description": "Invalid API key"
          },
          "409": {
            "description": "Idempotency key conflict"
          },
          "422": {
            "description": "Bad category, disabled angle, or synthetic not allowed"
          },
          "429": {
            "description": "Rate limit or quota exceeded"
          }
        },
        "summary": "Create Job",
        "tags": [
          "generate"
        ]
      }
    },
    "/api/v2/health": {
      "get": {
        "operationId": "get_health_api_v2_health_get",
        "responses": {
