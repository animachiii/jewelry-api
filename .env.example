# --- Application ---
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO
API_BASE_PATH=/api/v2
MOCK_MODE=false                    # Phase 1 mock server — must be false in production

# --- Supabase Postgres ---
# Session pooler (5432), NOT transaction pooler (6543) — SQLAlchemy uses prepared statements
# Local dev substitute until a Supabase project exists: postgresql+asyncpg://postgres:postgres@localhost:5433/jewelry
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@<host>:5432/postgres

# --- Supabase Storage ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=              # service role key — never expose to any client
BUCKET_INPUTS=jewelry-inputs
BUCKET_OUTPUTS=jewelry-outputs
SIGNED_URL_TTL_SECONDS=3600

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Celery / workers ---
IO_QUEUE_CONCURRENCY=20

# --- Models (pinned, never floating aliases) ---
# The model the QA *judge* runs on. Left empty, the judge falls back to the
# config version's own model_version -- which is an image *generation* model
# (live: gemini-3.1-flash-image), i.e. the wrong tool for a JSON verdict and
# the most demand-constrained capacity class Gemini serves. Set this to a
# text-capable model to stop judge-call 503s at the source.
QA_MODEL_ID=
# Bounded in-process retry around the judge call, mirroring the generation
# call's own MAX_ATTEMPTS. QA calls are never billed, so a retry costs only
# latency.
QA_MAX_ATTEMPTS=3
QA_RETRY_BACKOFF_SECONDS=0.5
# true  -> a sub-job the judge never managed to evaluate COMPLETES
#          (qa_status NOT_APPLICABLE, qa_score NULL) instead of going to the
#          human review queue. An unevaluated output is not a rejected one.
# false -> restores Phase 9's original fail-open-to-a-human behaviour.
# A real judge verdict below threshold always flags either way.
QA_PASS_ON_PROVIDER_ERROR=true

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=       # path or inline JSON
CONFIG_SHEET_ID=
CONFIG_SYNC_CRON=*/15 * * * *

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_RATE_LIMIT_PER_MINUTE=60

# --- RECOLOR mask processing (Phase 19) ---
MASK_ERODE_PX=2
MASK_FEATHER_PX=3
MASK_MIN_COVERAGE_PCT=0.5
MASK_MAX_COVERAGE_PCT=60.0

# --- Image processing memory ceiling (post-Phase-20 incident, 2026-08-24) ---
# Caps the working resolution for RECOLOR/MIX's pre-provider-call overlay
# building — never the client-facing composited output, which always stays
# full resolution. See app/config.py's own note for the live OOM this fixes.
WORKING_MAX_EDGE=2048

# --- Observability ---
SENTRY_DSN=
